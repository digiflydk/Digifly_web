rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public site settings (readable by anyone, writable only by admins)
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public navigation
    match /navigation/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pages: public can read only published pages; admins can read/write everything
    match /pages/{doc=**} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // Cases: expose only published
    match /cases/{caseId} {
      allow read: if resource.data.published == true;
      allow write: if isAdmin();
    }

    // Admin-only namespace
    match /dadmin/{doc=**} {
      allow read, write: if isAdmin();
    }

    // QA runs are restricted to admins
    match /qaRuns/{runId} {
      allow read, write: if isAdmin();
    }
    
    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
