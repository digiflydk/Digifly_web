
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      // In public mode, we can't check claims. For now, allow writes if signed in.
      // In a real app, this would be:
      // return signedIn() && request.auth.token.admin == true;
      return signedIn();
    }

    // Public reads for content needed by the site
    match /site/{doc} {
      allow get: if true;
      allow write: if isAdmin(); // Admin can write
    }
    
    match /pages/{pageId} {
      // Allow public read only if the document is marked as published
      allow get: if resource.data.published == true;
      // Admins can list and write to all pages regardless of published status
      allow list, write: if isAdmin();
    }

    // Special case for homepage, which might not have `published` field initially
    match /pages/home {
      allow read: if true;
    }
    
    match /cases/{caseId} {
      allow read: if resource.data.published == true;
      allow list, write: if isAdmin();
    }
    
    // --- Admin-gated sections ---
    
    // Navigation is read-only for public, writable by admins.
    // However, the admin panel now uses server-side writes, so this rule
    // primarily serves as a client-side read lock for non-admins.
    match /navigation/{doc=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin-only area
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }
  }
}
