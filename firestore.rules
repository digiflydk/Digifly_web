
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Public site settings: only this doc is publicly readable
    match /settings/site {
      allow get, list: if true;
      allow write: if isAdmin();
    }
    
    // Legacy collections locked to admin
    match /site/{docId} {
      allow read, write: if isAdmin();
    }
    match /navigation/{doc=**} {
      allow read, write: if isAdmin();
    }
     match /pages/{doc=**} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
    match /cases/{caseId} {
      allow read: if resource.data.published == true;
      allow write: if isAdmin();
    }

    // Admin-only namespace
    match /dadmin/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // QA runs are readable by anyone, writable only by admins/functions
    match /qa_runs/{runId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
