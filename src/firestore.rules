
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Publicly readable content
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /navigation/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /pages/{doc=**} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
    match /cases/{caseId} {
      allow read: if resource.data.published == true;
      allow write: if isAdmin();
    }

    // Admin-only settings
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }
    match /siteSettings/{docId} { // Legacy, should be removed later
        allow read, write: if isAdmin();
    }
    match /homePage/{docId} { // Legacy, should be removed later
        allow read, write: if isAdmin();
    }
     match /playwright/{docId} { // Legacy, should be removed later
        allow read, write: if isAdmin();
    }


    // Admin-only namespace for other tools
    match /dadmin/{doc=**} {
      allow read, write: if isAdmin();
    }

    // QA runs are readable by anyone, writable only by admins/functions
    match /qa_runs/{runId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
