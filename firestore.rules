rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public, non-sensitive display settings
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public navigation docs
    match /navigation/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pages: only published pages are public
    match /pages/{slug} {
      allow read: if resource.data.published == true;
      allow write: if isAdmin();
    }

    // Cases: expose only published
    match /cases/{caseId} {
      allow read: if resource.data.published == true;
      allow write: if isAdmin();
    }

    // QA runs are restricted to admins
    match /qaRuns/{runId} {
      allow read, write: if isAdmin();
    }

    // Everything under dadmin is restricted to admins
    match /dadmin/{document=**} {
      allow read, write: if isAdmin();
    }

    // Default: deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null
             && request.auth.token.role == 'admin';
    }
  }
}
