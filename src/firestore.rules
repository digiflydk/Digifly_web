rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() { return request.auth != null; }
    function isAdmin() { return isAuthed() && request.auth.token.admin == true; }

    // Public read for site rendering
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /cases/{caseId} {
      // Public can only read published cases. Admins can read all.
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }
    
    // Legacy nav, keep for seeding/migration for now
    match /navigation/{docId} {
        allow read: if true;
        allow write: if isAdmin();
    }

    // Admin-only collections
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    // Audit logs should be readable by admins from the client
    match /auditLogs/{logId} {
        allow create: if isAuthed(); // Allow backend to create logs
        allow read: if isAdmin();
        allow update, delete: if false; // Disallow client updates/deletes
    }

    // QA test runs should be readable by admins from the client
    match /qaRuns/{runId} {
      allow read: if isAuthed(); // Allow authenticated users to read test runs from the client-side UI.
      allow write: if false; // Disallow client writes; only backend/CI can create/update.
    }

    // Fallback to deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
