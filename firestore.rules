rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // By default, make all documents publicly readable,
    // but only allow writes from the admin server (e.g. via the CMS API).
    // This allows the front-end to fetch data in real-time, like for design tokens.
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
