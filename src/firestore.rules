
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() { return request.auth != null; }
    function isAdmin() { return isAuthed() && request.auth.token.role == "admin"; }

    // Public site reads
    match /site/{doc} {
      allow read: if true;
      allow write: if false;
    }
    
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin(); // Allow admins to write
    }
    
    match /cases/{caseId} {
      // Allow public read only if published
      allow read: if resource.data.published == true;
      // Allow admins to list/write all cases
      allow list, write: if isAdmin();
    }
    
    // Admin-managed CMS (navigation)
    match /cms/{docId} {
      allow read, write: if isAdmin();
    }
    
    match /navigation/{docId} {
        allow read, write: if isAdmin();
    }

    match /admins/{uid} {
      allow read, write: if isAdmin();
    }
    match /auditLogs/{logId} {
        allow read, write: if isAdmin();
    }
  }
}
