
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() { return request.auth != null; }
    function isAdmin() { return isAuthed() && request.auth.token.role == "admin"; }

    // Public site reads
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /pages/{pageId} {
      allow read: if true; // Public pages are world-readable
      allow write: if isAdmin(); // But only admins can write
    }
    
    match /cases/{caseId} {
      allow read: if resource.data.published == true;
      allow list, write: if isAdmin();
    }
    
    match /navigation/{docId} {
        allow read: if true; // Nav is public
        allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
        allow create: if isAuthed(); // Allow authenticated users to create logs
        allow read, update, delete: if isAdmin(); // Admins can manage all logs
    }
  }
}
