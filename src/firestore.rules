
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() { return request.auth != null; }
    // Allow admin access for any authenticated user, since dadmin is protected
    function isAdmin() { return isAuthed(); } 

    // Public read access for site rendering content
    match /site/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /pages/{pageId} {
      allow read: if true; // Public pages are world-readable
      allow write: if isAdmin(); // But only admins can write
    }
    
    match /cases/{caseId} {
      // Public can only read published cases. Admins can read all.
      allow read: if resource.data.published == true || isAdmin();
      allow list, write: if isAdmin();
    }
    
    // Legacy nav, might be removed later
    match /navigation/{docId} {
        allow read: if true; // Nav is public
        allow write: if isAdmin();
    }

    // Admin-only collections
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    // Audit logs should be readable by admins, creatable by authed (backend)
    match /auditLogs/{logId} {
        allow create, read: if isAdmin();
        allow update, delete: if false; // Disallow client updates/deletes
    }

    // QA test runs should be readable by admins from the client, and creatable by backend
    match /qaRuns/{runId} {
      allow read, create: if isAdmin();
      allow write: if false; // Disallow client updates/deletes
    }

    // Developer settings for logging are admin-readable
    match /developerSettings/logging {
        allow read, write: if isAdmin();
    }
  }
}
