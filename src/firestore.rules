
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // --- PUBLIC READS ---

    // Public site settings: only this doc is publicly readable by anyone
    match /settings/site {
      allow get: if true;
      allow list, write: if isAdmin(); // List and write only for admin
    }
    
    // Public content
    match /pages/{doc=**} {
      allow get: if resource.data.published == true;
      allow list, write: if isAdmin();
    }
    match /cases/{caseId} {
      allow get: if resource.data.published == true;
      allow list, write: if isAdmin();
    }
     match /navigation/{doc=**} {
      allow get: if true;
      allow list, write: if isAdmin();
    }


    // --- ADMIN-ONLY ---
    
    // Legacy collections are admin-only
    match /site/{docId} {
      allow read, write: if isAdmin();
    }
    
    // Entire admin namespace
    match /dadmin/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // QA runs are readable by anyone, writable only by admins/functions
    match /qa_runs/{runId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
