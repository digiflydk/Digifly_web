
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // --- PUBLIC READS ---
    match /site/settings {
      allow get: if true;
      allow write: if isAdmin();
    }
    
    // Public content
    match /pages/{doc=**} {
      allow get: if resource.data.published == true;
      allow list, write: if isAdmin();
    }
    match /cases/{caseId} {
      allow get: if resource.data.published == true;
      allow list, write: if isAdmin();
    }
     match /navigation/{doc=**} {
      allow get: if true;
      allow list, write: if isAdmin();
    }


    // --- ADMIN-ONLY ---
    
    // Entire admin namespace
    match /dadmin/{document=**} {
      allow read, write: if isAdmin();
    }
    
    // QA runs are readable by admins
    match /qa_runs/{runId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Audit logs can be created by any authenticated user, but only read by admins
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
