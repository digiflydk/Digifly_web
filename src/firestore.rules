
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      // For this app, we assume writes are server-side via Admin SDK,
      // which bypasses rules. This rule is a safeguard for any client-side attempts.
      // A real implementation would check for a custom claim: request.auth.token.admin == true
      return signedIn();
    }

    // Public reads for content needed by the site
    match /site/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /cases/{caseId} {
      allow read: if resource.data.published == true;
      allow list, write: if isAdmin();
    }
    
    // CMS singletons like navigation are public-read, admin-write.
    match /cms/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin-only area for audit logs etc.
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }
    match /auditLogs/{logId} {
        allow read, write: if isAdmin();
    }
  }
}
