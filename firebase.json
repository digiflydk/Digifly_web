
{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
          { "key": "X-Robots-Tag", "value": "all" }
        ]
      }
    ],
    "redirects": [
      { "source": "/.git/**", "destination": "/404", "type": 301 },
      { "source": "/.env", "destination": "/404", "type": 301 },
      { "source": "/.DS_Store", "destination": "/404", "type": 301 },
      { "source": "/wordpress", "destination": "/404", "type": 301 },
      { "source": "/swagger*", "destination": "/404", "type": 301 },
      { "source": "/api-docs*", "destination": "/404", "type": 301 },
      { "source": "/v2/api-docs", "destination": "/404", "type": 301 },
      { "source": "/v3/api-docs", "destination": "/404", "type": 301 },
      { "source": "/api/swagger.json", "destination": "/404", "type": 301 },
      { "source": "/api/gql", "destination": "/404", "type": 301 },
      { "source": "/api/graphql", "destination": "/404", "type": 301 },
      { "source": "/graphql", "destination": "/404", "type": 301 },
      { "source": "/login.action", "destination": "/404", "type": 301 },
      { "source": "/server-status", "destination": "/404", "type": 301 },
      { "source": "/info.php", "destination": "/404", "type": 301 }
    ],
    "rewrites": [
      {
        "source": "**",
        "function": "server"
      }
    ]
  }
}
