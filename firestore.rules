
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public navigation (header/footer menus)
    match /navigation/{navId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public site settings (brand + basic SEO only)
    match /site/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // CMS pages are public only when published == true
    match /pages/{pageId} {
      allow read: if resource.data.published == true;
      allow write: if request.auth != null;
    }

    // Case studies (public only when published)
    match /cases/{caseId} {
      allow read: if resource.data.published == true;
      allow write: if request.auth != null;
    }

    // QA reports remain private (admin-only)
    match /qaReports/{reportId} {
      allow read, write: if request.auth != null;
    }
  }
}
